# Alpaca keys live in Supabase, NOT in this file. To set them:
#   supabase login
#   supabase link --project-ref swbrewprhjmujomqtdpc
#   supabase secrets set \
#     ALPACA_PAPER_KEY_ID=... \
#     ALPACA_PAPER_SECRET=... \
#     ALPACA_LIVE_KEY_ID=... \
#     ALPACA_LIVE_SECRET=...
#   supabase functions deploy alpaca
#
# This file only documents optional VITE_* overrides for client-side dev.

# Point the client at a locally-served edge function instead of the deployed one
# (only useful when iterating on supabase/functions/alpaca/index.ts itself):
# VITE_ALPACA_FUNCTION_URL=http://localhost:54321/functions/v1/alpaca
